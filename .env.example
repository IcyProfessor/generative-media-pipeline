# Copy to .env in this directory for local use. .env is Git-ignored; NEVER commit real keys.
GEMINI_API_KEY=
# Verify account access using list-models before requesting generation.
GEMINI_MODEL=gemini-3.5-flash-lite
SUNO_API_KEY=
# Confirm the base URL in YOUR provider dashboard before sending any key.
SUNO_BASE_URL=https://api.sunoapi.org/api/v1
SUNO_MODEL=V5
# HTTPS callback endpoint controlled by you. No callback server is bundled.
SUNO_CALLBACK_URL=
REDIS_URL=redis://127.0.0.1:6379/0
GENMEDIA_QUEUE_NAMESPACE=genmedia
